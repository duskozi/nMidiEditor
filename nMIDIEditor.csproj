<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <RootNamespace>nMIDI</RootNamespace>
    <AssemblyName>nMIDIEditor</AssemblyName>
    <ThemeInfoResourceDictionaryLocation>None</ThemeInfoResourceDictionaryLocation>

    <!-- NinePatchLib.dll is a 64-bit native library, so the app runs as a 64-bit process. -->
    <PlatformTarget>x64</PlatformTarget>

    <Version>2.3.0</Version>
    <Product>nMIDI Editor</Product>
    <Description>MIDI editor and player with a piano roll, track lanes and a piano keyboard.</Description>
    <Authors>Duško</Authors>
    <Company>Duško</Company>
    <Copyright>Copyright © 2026 Duško</Copyright>
  </PropertyGroup>

  <!-- The tests are a separate project. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Page Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Melanchall.DryWetMidi" Version="7.1.0" />
  </ItemGroup>

  <!-- NinePatchWpf is used as a prebuilt library from lib/NinePatchWpf. To update it, build
       NinePatchWpf in Release and copy its output (the files listed below) into that folder. -->
  <ItemGroup>
    <Reference Include="NinePatchWpf">
      <HintPath>lib\NinePatchWpf\NinePatchWpf.dll</HintPath>
    </Reference>
    <Reference Include="NinePatch.Core">
      <HintPath>lib\NinePatchWpf\NinePatch.Core.dll</HintPath>
    </Reference>
    <None Include="lib\NinePatchWpf\NinePatchLib.dll" Link="NinePatchLib.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- nPianoFingering (hand separation and fingering) is used as a prebuilt library from lib/nPianoFingering.
       To update it, build src/nPianoFingering.Core in Release and copy nPianoFingering.Core.dll (and .xml) there. -->
  <ItemGroup>
    <Reference Include="nPianoFingering.Core">
      <HintPath>lib\nPianoFingering\nPianoFingering.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
