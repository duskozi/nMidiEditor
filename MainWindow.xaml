<Window x:Class="nMIDI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:np="urn:ninepatch:wpf"
        xmlns:roll="clr-namespace:nMIDI.PianoRoll"
        xmlns:kb="clr-namespace:nMIDI.Piano"
        Title="nMIDI Editor"
        Icon="/Assets/nMIDIEditor.ico"
        Width="1360" Height="900" MinWidth="980" MinHeight="600"
        Background="{DynamicResource Bg0}"
        Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="12"
        UseLayoutRounding="True"
        AllowDrop="True"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- transport bar -->
            <RowDefinition Height="Auto"/>   <!-- tracks header -->
            <RowDefinition Height="Auto"/>   <!-- track list (collapsible) -->
            <RowDefinition Height="Auto"/>   <!-- edit toolbar -->
            <RowDefinition Height="*" MinHeight="120"/>   <!-- piano roll -->
            <RowDefinition Height="Auto"/>   <!-- lane splitter -->
            <RowDefinition x:Name="rowLane" Height="120" MinHeight="31"/>   <!-- velocity / controller lane (collapsible) -->
            <RowDefinition Height="Auto"/>   <!-- splitter -->
            <RowDefinition x:Name="rowKeyboard" Height="160" MinHeight="32"/>   <!-- keyboard (collapsible) -->
            <RowDefinition Height="Auto"/>   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- Transport bar -->
        <Border Grid.Row="0" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <!-- Five columns, so nothing can overlap: buttons, file info (shrinks with an ellipsis), transport,
                 a spacer that keeps the transport near the middle, view options. When the window is narrow,
                 LayoutBars() makes buttons icon-only, then shrinks the speed slider, then moves the view
                 options to a second row. -->
            <Grid x:Name="gridTop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="40"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo, open, save -->
                <StackPanel x:Name="pnlTopLeft" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontSize="18" Margin="0,0,14,2">
                        <Run Text="n" Foreground="{DynamicResource Accent}" FontWeight="Bold"/><Run Text="MIDI" FontWeight="SemiBold"/><Run x:Name="runLogoEditor" Text=" Editor" FontWeight="Normal" Foreground="{DynamicResource TextDim}" FontSize="13"/>
                    </TextBlock>
                    <Button Style="{DynamicResource ToolButton}" Click="OnNew" Padding="8,4" ToolTip="New empty song (Ctrl+N)">
                        <TextBlock Text="&#xE8A5;" Style="{DynamicResource Icon}"/>
                    </Button>
                    <Button Style="{DynamicResource ToolButton}" Click="OnOpen" Margin="4,0,0,0" ToolTip="Open a MIDI file (Ctrl+O). You can also drop one on the window.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" Style="{DynamicResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="lblOpen" Text="Open"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnRecent" Style="{DynamicResource ToolButton}" Click="OnRecentClick" Margin="2,0,0,0" Padding="5,4"
                            ToolTip="Recent files">
                        <TextBlock Text="&#xE70D;" Style="{DynamicResource Icon}" FontSize="9"/>
                    </Button>
                    <Button x:Name="btnSave" Style="{DynamicResource ToolButton}" Click="OnSave" Margin="4,0,0,0" Padding="8,4"
                            ToolTip="Save (Ctrl+S)">
                        <TextBlock Text="&#xE74E;" Style="{DynamicResource Icon}"/>
                    </Button>
                    <Button x:Name="btnSaveAs" Style="{DynamicResource ToolButton}" Click="OnSaveAs" Margin="4,0,0,0" Padding="8,4"
                            ToolTip="Save as a new file, format 1 or format 0 (Ctrl+Shift+S)">
                        <TextBlock Text="&#xE792;" Style="{DynamicResource Icon}"/>
                    </Button>
                </StackPanel>

                <!-- File name and info -->
                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" MaxWidth="320" HorizontalAlignment="Left">
                    <TextBlock x:Name="txtFileName" Text="No file" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="txtFileInfo" Text="Open or drop a .mid file" Foreground="{DynamicResource TextDim}" FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Transport + displays (fixed widths, so the group never changes size while playing) -->
                <Border x:Name="bdTransport" Grid.Column="2" Style="{DynamicResource TransportGroup}">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="btnRewind" Style="{DynamicResource TransportButton}" Content="&#xE892;"
                                      Click="OnRewind" ToolTip="Back to start (Home)"/>
                        <ToggleButton x:Name="btnPlay" Style="{DynamicResource TransportButton}" Content="&#xE768;" Margin="4,0,0,0"
                                      Tag="{DynamicResource PlayBrush}" Click="OnPlay" ToolTip="Play (Space)"/>
                        <ToggleButton x:Name="btnPause" Style="{DynamicResource TransportButton}" Content="&#xE769;" Margin="4,0,0,0"
                                      Tag="{DynamicResource SoloBrush}" Click="OnPause" ToolTip="Pause (Space)"/>
                        <ToggleButton x:Name="btnStop" Style="{DynamicResource TransportButton}" Content="&#xE71A;" Margin="4,0,0,0"
                                      Tag="{DynamicResource StopBrush}" Click="OnStop" ToolTip="Stop and go back to start"/>
                        <ToggleButton x:Name="btnPanic" Style="{DynamicResource TransportButton}" Content="&#xE7BA;" Margin="4,0,0,0"
                                      Tag="{DynamicResource MuteBrush}" Click="OnPanic"
                                      ToolTip="Panic (Esc): pause and send All Notes Off on all 16 channels of every MIDI output port"/>
                        <ToggleButton x:Name="btnRecord" Style="{DynamicResource TransportButton}" Content="&#xE7C8;" Margin="4,0,0,0"
                                      Tag="{DynamicResource RecordBrush}" Click="OnRecordClick" MouseRightButtonUp="OnRecordRightClick"
                                      ToolTip="Record from the MIDI input into the edited track (R). Right-click for overdub or replace, count-in and quantize."/>
                        <ToggleButton x:Name="btnMetronome" Style="{DynamicResource TransportButton}" Content="&#xEC4A;" Margin="4,0,0,0"
                                      Tag="{DynamicResource SoloBrush}" Click="OnMetronomeClick"
                                      ToolTip="Metronome: click on every beat while playing (C). It plays on channel 10 of the edited track's port."/>

                        <!-- Position display -->
                        <Border Style="{DynamicResource LcdPanel}" Margin="10,0,0,0" Padding="8,1" Width="150">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txtTime" Text="00:00.000" FontFamily="{DynamicResource MonoFont}" FontSize="19"
                                           Foreground="{DynamicResource LcdText}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="txtBars" Text="  1.1.000" FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                           Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tempo display -->
                        <Border Style="{DynamicResource LcdPanel}" Margin="6,0,0,0" Padding="6,1" Width="104">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtTempo" Text="120.0" FontFamily="{DynamicResource MonoFont}" FontSize="16"
                                               Foreground="{DynamicResource Text}" Width="54" TextAlignment="Right"/>
                                    <TextBlock Text="BPM" Style="{DynamicResource CapsLabel}" Margin="4,3,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="txtSignature" Text="4/4" FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                           Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Speed -->
                        <StackPanel Margin="12,0,4,0" VerticalAlignment="Center"
                                    ToolTip="Playback speed. Double-click to reset to 100 %.">
                            <DockPanel>
                                <TextBlock Text="SPEED" Style="{DynamicResource CapsLabel}"/>
                                <TextBlock x:Name="txtSpeed" Text="100 %" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                           HorizontalAlignment="Right" Width="44" TextAlignment="Right"/>
                            </DockPanel>
                            <Slider x:Name="sldSpeed" Style="{DynamicResource DarkSlider}" Width="130"
                                    Minimum="25" Maximum="200" Value="100" SmallChange="5" LargeChange="10"
                                    ValueChanged="OnSpeedChanged" MouseDoubleClick="OnSpeedReset"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- View options -->
                <StackPanel x:Name="pnlTopRight" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="btnFollow" Style="{DynamicResource ToolToggle}" IsChecked="True"
                                  ToolTip="Turn the page when the playhead reaches the right edge (F)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B0;" Style="{DynamicResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="lblFollow" Text="Follow"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="tglLoop" Style="{DynamicResource ToolToggle}" Margin="6,0,0,0" Click="OnLoopClick"
                                  ToolTip="Loop the range set in the ruler's upper band (L). Drag there to set it.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8EE;" Style="{DynamicResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="lblLoop" Text="Loop"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{DynamicResource ToolButton}" Margin="6,0,0,0" Click="OnFit"
                            ToolTip="Show the whole song (or double-click a scroll bar thumb)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9A6;" Style="{DynamicResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="lblFit" Text="Fit"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource ToolButton}" Margin="6,0,0,0" Click="OnOpenLanes"
                            ToolTip="Open the track lanes window: every track in its own lane, one under the other">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A9;" Style="{DynamicResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="lblLanes" Text="Lanes"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="capColor" Text="COLOR" Style="{DynamicResource CapsLabel}" Margin="14,0,6,0"/>
                    <ComboBox x:Name="cmbColorMode" Width="96" SelectedIndex="0" SelectionChanged="OnColorModeChanged">
                        <ComboBoxItem Content="Track"/>
                        <ComboBoxItem Content="Velocity"/>
                    </ComboBox>
                    <Button x:Name="btnSettings" Style="{DynamicResource ToolButton}" Margin="8,0,0,0" Padding="8,4"
                            Click="OnSettingsClick" ToolTip="Settings and theme (Ctrl+,)">
                        <TextBlock Text="&#xE713;" Style="{DynamicResource Icon}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tracks header -->
        <Border Grid.Row="1" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                Padding="8,0" Height="32">
            <DockPanel>
                <ToggleButton x:Name="tglTracks" Style="{DynamicResource ExpanderToggle}" IsChecked="True" DockPanel.Dock="Left"
                              ToolTip="Show or hide the track list">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TRACKS" Style="{DynamicResource CapsLabel}" Foreground="{DynamicResource Text}"/>
                        <TextBlock x:Name="txtTrackSummary" Text="" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnTracks" Style="{DynamicResource ToolButton}" Height="24" Padding="8,0" Margin="0,0,14,0"
                            Click="OnTracksMenuClick" Focusable="False"
                            ToolTip="Add, duplicate, delete, move, merge or split tracks, and track settings. Right-click a track for the same menu.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{DynamicResource Icon}" FontSize="11" Margin="0,0,5,0"/>
                            <TextBlock Text="Tracks" FontSize="11"/>
                            <TextBlock Text="&#xE70D;" Style="{DynamicResource Icon}" FontSize="8" Margin="5,1,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="INPUT" Style="{DynamicResource CapsLabel}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cmbInput" Width="170" Height="24" Focusable="False" SelectionChanged="OnInputChanged"
                              ToolTip="MIDI input (keyboard or controller) for recording, step input and playing along"/>
                    <ToggleButton x:Name="tglThru" Style="{DynamicResource ToolToggle}" Height="24" Padding="7,0" Margin="4,0,14,0"
                                  Focusable="False" Click="OnThruClick" IsChecked="True"
                                  ToolTip="Thru: what you play on the MIDI input sounds on the edited track's port and channel">
                        <TextBlock Text="Thru" FontSize="11"/>
                    </ToggleButton>
                    <TextBlock Text="ALL OUTPUTS" Style="{DynamicResource CapsLabel}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cmbAllOutputs" Width="200" Height="24" ItemsSource="{Binding OutputNames}"
                              SelectionChanged="OnAllOutputsChanged" ToolTip="Send every track to this port"/>
                    <Button Style="{DynamicResource ToolButton}" Height="24" Padding="7,0" Margin="6,0,0,0"
                            Click="OnRefreshOutputs" ToolTip="Look for MIDI ports again">
                        <TextBlock Text="&#xE72C;" Style="{DynamicResource Icon}" FontSize="11"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Track list -->
        <Border Grid.Row="2" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsChecked, ElementName=tglTracks, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer Style="{DynamicResource ThinScrollViewer}" MaxHeight="232" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="lstTracks" ItemsSource="{Binding Tracks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="row" Height="29" Background="Transparent" BorderBrush="{DynamicResource LineSoft}"
                                    BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTrackRowClick" MouseRightButtonUp="OnTrackRowRightClick"
                                    ToolTip="Click to edit this track in the piano roll. Ctrl+click to edit it together with the others.">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="240"/>
                                    </Grid.ColumnDefinitions>

                                    <Rectangle Grid.Column="0" Fill="{Binding Brush}" Margin="0,3"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="{DynamicResource TextFaint}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBlock x:Name="activeMark" Grid.Column="1" Text="&#xE70F;" Style="{DynamicResource Icon}" FontSize="11"
                                               Foreground="{DynamicResource Accent}" Visibility="Collapsed" Background="{DynamicResource Bg1}"
                                               ToolTip="This track is being edited"/>

                                    <StackPanel x:Name="title" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                        <TextBlock Text="{Binding Instrument}" Foreground="{DynamicResource TextDim}" FontSize="11"
                                                   Margin="8,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding ChannelText}" Foreground="{DynamicResource TextDim}"
                                               FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding NotesText}" Foreground="{DynamicResource TextDim}"
                                               FontSize="11" VerticalAlignment="Center"/>

                                    <!-- Activity meter -->
                                    <Border Grid.Column="5" Height="6" Width="52" CornerRadius="3" Background="{DynamicResource LcdBg}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True">
                                        <Border CornerRadius="3" Background="{DynamicResource MeterBrush}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Level}"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Border>

                                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <ToggleButton Style="{DynamicResource ChipToggle}" Content="M" Tag="{DynamicResource MuteBrush}"
                                                      IsChecked="{Binding IsMuted}" MouseRightButtonUp="OnMuteRightClick"
                                                      ToolTip="Mute. Right-click: mute only this track"/>
                                        <ToggleButton Style="{DynamicResource ChipToggle}" Content="S" Tag="{DynamicResource SoloBrush}"
                                                      IsChecked="{Binding IsSolo}" MouseRightButtonUp="OnSoloRightClick"
                                                      ToolTip="Solo. Right-click: solo only this track" Margin="3,0,0,0"/>
                                        <ToggleButton Style="{DynamicResource ChipToggle}" Tag="{DynamicResource ViewBrush}"
                                                      IsChecked="{Binding ShowNotes}" MouseRightButtonUp="OnShowRightClick"
                                                      ToolTip="Show notes. Right-click: show only this track" Margin="3,0,0,0">
                                            <TextBlock Text="&#xE7B3;" Style="{DynamicResource Icon}" FontSize="11"/>
                                        </ToggleButton>
                                    </StackPanel>

                                    <ComboBox Grid.Column="7" Height="22" FontSize="11" Margin="0,0,8,0"
                                              ItemsSource="{Binding DataContext.OutputNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding OutputDevice}" ToolTip="Output port of this track"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource Bg2}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsCoEdited}" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource ActiveRowBrush}"/>
                                    <Setter TargetName="activeMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="activeMark" Property="Opacity" Value="0.55"/>
                                    <Setter TargetName="activeMark" Property="ToolTip" Value="Edited together with the active track (Ctrl+click to stop)"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource ActiveRowBrush}"/>
                                    <Setter TargetName="activeMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="activeMark" Property="Opacity" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAudible}" Value="False">
                                    <Setter TargetName="title" Property="Opacity" Value="0.45"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Edit toolbar -->
        <Border Grid.Row="3" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                Padding="8,4">
            <DockPanel x:Name="pnlEdit" LastChildFill="True">
                <WrapPanel x:Name="pnlEditTools" Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock x:Name="capEdit" Text="EDIT" Style="{DynamicResource CapsLabel}" Foreground="{DynamicResource Text}" Margin="2,0,8,0"/>
                    <Border x:Name="bdActiveTrack" CornerRadius="4" Padding="7,2" Background="{DynamicResource Bg0}" MaxWidth="190"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center"
                            ToolTip="The track being edited. Click a track in the list, or a note of another track, to edit that track.">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="dotActiveTrack" Width="9" Height="9" Fill="{DynamicResource TextFaint}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtActiveTrack" Text="No track" TextTrimming="CharacterEllipsis" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <ToggleButton x:Name="tglSelect" Style="{DynamicResource ToolToggle}" Margin="10,0,0,0" Padding="8,2" Height="26"
                                  Click="OnToolClick" Tag="Select" IsChecked="True" Focusable="False"
                                  ToolTip="Select tool (1): click to select, drag notes to move, drag an edge to resize, drag empty space for a box.&#x0a;Ctrl+click adds or removes, Ctrl+drag copies, double-click empty space adds a note, Alt turns snapping off.">
                        <TextBlock Text="&#xE8B0;" Style="{DynamicResource Icon}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="tglDraw" Style="{DynamicResource ToolToggle}" Margin="3,0,0,0" Padding="8,2" Height="26"
                                  Click="OnToolClick" Tag="Draw" Focusable="False"
                                  ToolTip="Draw tool (2): click to add a note, drag right to set its length. Right-drag erases.">
                        <TextBlock Text="&#xE70F;" Style="{DynamicResource Icon}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="tglErase" Style="{DynamicResource ToolToggle}" Margin="3,0,0,0" Padding="8,2" Height="26"
                                  Click="OnToolClick" Tag="Erase" Focusable="False"
                                  ToolTip="Erase tool (3): click or drag over notes to delete them">
                        <TextBlock Text="&#xE75C;" Style="{DynamicResource Icon}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="tglSplit" Style="{DynamicResource ToolToggle}" Margin="3,0,0,0" Padding="8,2" Height="26"
                                  Click="OnToolClick" Tag="Split" Focusable="False"
                                  ToolTip="Split tool (4): click a note to cut it in two at the grid line. A selected note splits the whole selection.">
                        <TextBlock Text="&#xE8C6;" Style="{DynamicResource Icon}"/>
                    </ToggleButton>

                    <ToggleButton x:Name="tglStep" Style="{DynamicResource ToolToggle}" Margin="3,0,0,0" Padding="8,2" Height="26"
                                  Click="OnStepClick" Focusable="False"
                                  ToolTip="Step input (S): notes you play on the MIDI input or the keyboard below go in at the playhead with the Length box's length, and the playhead moves on. Play a chord to enter it at once. ← / → move the playhead, Backspace takes the last step back.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B1;" Style="{DynamicResource Icon}" Margin="0,0,5,0"/>
                            <TextBlock x:Name="lblStep" Text="Step" FontSize="11"/>
                        </StackPanel>
                    </ToggleButton>

                    <Button x:Name="btnUndo" Style="{DynamicResource ToolButton}" Margin="10,0,0,0" Padding="8,2" Height="26"
                            Click="OnUndo" Focusable="False" ToolTip="Undo (Ctrl+Z)">
                        <TextBlock Text="&#xE7A7;" Style="{DynamicResource Icon}"/>
                    </Button>
                    <Button x:Name="btnRedo" Style="{DynamicResource ToolButton}" Margin="3,0,0,0" Padding="8,2" Height="26"
                            Click="OnRedo" Focusable="False" ToolTip="Redo (Ctrl+Y)">
                        <TextBlock Text="&#xE7A6;" Style="{DynamicResource Icon}"/>
                    </Button>

                    <TextBlock x:Name="capGrid" Text="GRID" Style="{DynamicResource CapsLabel}" Margin="14,0,6,0"/>
                    <ComboBox x:Name="cmbGrid" Width="92" Height="24" Focusable="False" SelectionChanged="OnGridChanged"
                              ToolTip="Snap grid for drawing, moving and resizing. Hold Alt while dragging to place freely."/>
                    <TextBlock x:Name="capLength" Text="LENGTH" Style="{DynamicResource CapsLabel}" Margin="10,0,6,0"/>
                    <ComboBox x:Name="cmbLength" Width="92" Height="24" Focusable="False"
                              ToolTip="Length of new notes. 'Last' uses the length of the note you drew or resized last."/>
                    <TextBlock x:Name="capVelocity" Text="VELOCITY" Style="{DynamicResource CapsLabel}" Margin="10,0,6,0"/>
                    <TextBox x:Name="txtVelocity" Width="38" Height="24" Text="100" Style="{DynamicResource DarkTextBox}"
                             LostFocus="OnVelocityCommitted" KeyDown="OnVelocityKeyDown"
                             ToolTip="Velocity of new notes (1–127). Clicking a note picks up its velocity."/>

                    <Button x:Name="btnProcess" Style="{DynamicResource ToolButton}" Margin="10,0,0,0" Padding="8,2" Height="26"
                            Click="OnProcessClick" Focusable="False"
                            ToolTip="Quantize, transpose, change length or velocity, humanize, reverse, invert, select by rule. Works on the selected notes, or the whole track when nothing is selected.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9E9;" Style="{DynamicResource Icon}" Margin="0,0,5,0"/>
                            <TextBlock x:Name="lblProcess" Text="Process" FontSize="11"/>
                            <TextBlock Text="&#xE70D;" Style="{DynamicResource Icon}" FontSize="8" Margin="5,1,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnSong" Style="{DynamicResource ToolButton}" Margin="3,0,0,0" Padding="8,2" Height="26"
                            Click="OnSongMenuClick" Focusable="False"
                            ToolTip="Insert or delete bars, cut, copy and paste the loop range over all tracks, tempo, time and key signatures, markers">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D6;" Style="{DynamicResource Icon}" Margin="0,0,5,0"/>
                            <TextBlock x:Name="lblSong" Text="Song" FontSize="11"/>
                            <TextBlock Text="&#xE70D;" Style="{DynamicResource Icon}" FontSize="8" Margin="5,1,0,0"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="capScale" Text="SCALE" Style="{DynamicResource CapsLabel}" Margin="12,0,6,0"/>
                    <ComboBox x:Name="cmbKey" Width="52" Height="24" Focusable="False" SelectionChanged="OnScaleChanged"
                              ToolTip="Key of the scale"/>
                    <ComboBox x:Name="cmbScale" Width="130" Height="24" Margin="3,0,0,0" Focusable="False" SelectionChanged="OnScaleChanged"
                              MaxDropDownHeight="400" ToolTip="Shade the rows of the notes outside this scale"/>
                    <ToggleButton x:Name="tglScaleSnap" Style="{DynamicResource ToolToggle}" Margin="3,0,0,0" Padding="7,2" Height="26"
                                  Focusable="False" ToolTip="Drawn notes snap to the scale">
                        <TextBlock Text="&#xE71D;" Style="{DynamicResource Icon}"/>
                    </ToggleButton>

                    <ToggleButton x:Name="tglDimOthers" Style="{DynamicResource ToolToggle}" Margin="10,0,0,0" Padding="8,2" Height="26"
                                  IsChecked="True" Focusable="False" Click="OnDimOthersClick"
                                  ToolTip="Dim the notes of the other tracks so the edited track stands out">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE793;" Style="{DynamicResource Icon}" Margin="0,0,5,0"/>
                            <TextBlock x:Name="lblDim" Text="Dim others" FontSize="11"/>
                        </StackPanel>
                    </ToggleButton>
                </WrapPanel>

                <TextBlock x:Name="txtSelection" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,4,0"
                           Foreground="{DynamicResource TextDim}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Piano roll
             Drag a scroll bar thumb to scroll; drag one of its edges to zoom that axis. -->
        <np:NinePatchZoomViewer x:Name="viewer" Grid.Row="4"
                                ElementsSortedByY="True" ElementGap="1" MinElementSize="2"
                                MaxZoomX="50" MaxZoomY="40" ContentHeight="128"
                                Background="{DynamicResource RollBackground}" ChromeBackground="{DynamicResource Bg1}">
            <np:NinePatchZoomViewer.TopContent>
                <roll:TimelineRuler x:Name="ruler" Height="38"/>
            </np:NinePatchZoomViewer.TopContent>
            <np:NinePatchZoomViewer.LeftContent>
                <roll:PianoKeys x:Name="pianoKeys" Width="60"/>
            </np:NinePatchZoomViewer.LeftContent>
            <np:NinePatchZoomViewer.OverlayContent>
                <Grid IsHitTestVisible="False">
                <roll:FingerOverlay x:Name="fingerOverlay"/>
                <roll:PedalOverlay x:Name="pedalOverlay"/>
                <Canvas IsHitTestVisible="False">
                    <Line x:Name="playheadGlow" Y1="0" Y2="20000" Stroke="#FF4D4D" StrokeThickness="6" Opacity="0.16"/>
                    <Line x:Name="playheadLine" Y1="0" Y2="20000" Stroke="#FF4D4D" StrokeThickness="1" SnapsToDevicePixels="True"/>
                    <Rectangle x:Name="loopShade" Visibility="Collapsed" Fill="#142D8CFF" Height="20000"/>
                    <Line x:Name="loopStartLine" Visibility="Collapsed" Y1="0" Y2="20000" Stroke="#802D8CFF" StrokeThickness="1"/>
                    <Line x:Name="loopEndLine" Visibility="Collapsed" Y1="0" Y2="20000" Stroke="#802D8CFF" StrokeThickness="1"/>
                    <Rectangle x:Name="rubberBand" Visibility="Collapsed" Stroke="#9FCBFF" StrokeThickness="1"
                               Fill="#222D8CFF" StrokeDashArray="3 2" SnapsToDevicePixels="True"/>
                </Canvas>
                </Grid>
            </np:NinePatchZoomViewer.OverlayContent>
        </np:NinePatchZoomViewer>

        <!-- Shown until a file is loaded. -->
        <StackPanel x:Name="pnlEmpty" Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="&#xE8D6;" Style="{DynamicResource Icon}" FontSize="42" Foreground="{DynamicResource TextFaint}"/>
            <TextBlock Text="Drop a MIDI file here, press Ctrl+O to open one, or Ctrl+N for a new song" Foreground="{DynamicResource TextDim}" FontSize="14"
                       Margin="0,12,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Lane
             Velocity, controller, pitch bend, pressure or program changes of the edited track,
             on the piano roll's time axis. The header also edits the selected notes. -->
        <GridSplitter x:Name="splitLane" Grid.Row="5" Height="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource Bg0}" ResizeDirection="Rows" ShowsPreview="False"
                      ToolTip="Drag to resize the lane"/>

        <DockPanel Grid.Row="6" Background="{DynamicResource Bg1}">
            <Border DockPanel.Dock="Top" Height="30" Padding="8,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1">
                <DockPanel>
                    <ToggleButton x:Name="tglLane" Style="{DynamicResource ExpanderToggle}" IsChecked="True" DockPanel.Dock="Left"
                                  Checked="OnLaneToggled" Unchecked="OnLaneToggled" ToolTip="Show or hide the lane">
                        <TextBlock Text="LANE" Style="{DynamicResource CapsLabel}" Foreground="{DynamicResource Text}"/>
                    </ToggleButton>
                    <ComboBox x:Name="cmbLane" DockPanel.Dock="Left" Width="190" Height="24" Margin="10,0,0,0" Focusable="False"
                              MaxDropDownHeight="420" SelectionChanged="OnLaneChanged"
                              ToolTip="What the lane shows. ● marks controllers the edited track uses."/>
                    <TextBlock x:Name="txtLaneValue" DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDim}" FontSize="11" MinWidth="120"/>

                    <StackPanel x:Name="pnlNote" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="The selected note, or the selection. Type a value and press Enter. Velocity, pitch and start accept +n or −n to change by an amount.">
                        <TextBlock Text="NOTE" Style="{DynamicResource CapsLabel}" Foreground="{DynamicResource Text}" Margin="0,0,8,0"/>
                        <TextBlock Text="PITCH" Style="{DynamicResource CapsLabel}" Margin="0,0,4,0"/>
                        <TextBox x:Name="txtNotePitch" Width="46" Height="22" Style="{DynamicResource DarkTextBox}" Tag="Pitch"
                                 KeyDown="OnNoteFieldKeyDown" LostFocus="OnNoteFieldLostFocus" ToolTip="Note name (C4, F#3, Bb2) or number (60)"/>
                        <TextBlock Text="START" Style="{DynamicResource CapsLabel}" Margin="8,0,4,0"/>
                        <TextBox x:Name="txtNoteStart" Width="74" Height="22" Style="{DynamicResource DarkTextBox}" Tag="Start"
                                 KeyDown="OnNoteFieldKeyDown" LostFocus="OnNoteFieldLostFocus" ToolTip="Bar.beat.tick (1.1.000), or +n / −n ticks"/>
                        <TextBlock Text="LENGTH" Style="{DynamicResource CapsLabel}" Margin="8,0,4,0"/>
                        <TextBox x:Name="txtNoteLength" Width="52" Height="22" Style="{DynamicResource DarkTextBox}" Tag="Length"
                                 KeyDown="OnNoteFieldKeyDown" LostFocus="OnNoteFieldLostFocus" ToolTip="Length in ticks"/>
                        <TextBlock Text="VEL" Style="{DynamicResource CapsLabel}" Margin="8,0,4,0"/>
                        <TextBox x:Name="txtNoteVelocity" Width="38" Height="22" Style="{DynamicResource DarkTextBox}" Tag="Velocity"
                                 KeyDown="OnNoteFieldKeyDown" LostFocus="OnNoteFieldLostFocus" ToolTip="Velocity 1–127"/>
                        <TextBlock Text="REL" Style="{DynamicResource CapsLabel}" Margin="8,0,4,0"/>
                        <TextBox x:Name="txtNoteRelease" Width="34" Height="22" Style="{DynamicResource DarkTextBox}" Tag="Release"
                                 KeyDown="OnNoteFieldKeyDown" LostFocus="OnNoteFieldLostFocus" ToolTip="Release (note-off) velocity 0–127"/>
                        <TextBlock Text="CH" Style="{DynamicResource CapsLabel}" Margin="8,0,4,0"/>
                        <TextBox x:Name="txtNoteChannel" Width="30" Height="22" Style="{DynamicResource DarkTextBox}" Tag="Channel"
                                 KeyDown="OnNoteFieldKeyDown" LostFocus="OnNoteFieldLostFocus" ToolTip="MIDI channel 1–16"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <roll:ControllerLane x:Name="lane"/>
        </DockPanel>

        <!-- Keyboard
             Whole window width. Drag the bar above it to change its height. -->
        <GridSplitter x:Name="splitKeyboard" Grid.Row="7" Height="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource Bg0}" ResizeDirection="Rows" ShowsPreview="False"
                      ToolTip="Drag to resize the keyboard"/>

        <DockPanel Grid.Row="8" Background="{DynamicResource Bg1}">
            <Border DockPanel.Dock="Top" Height="30" Padding="8,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1">
                <DockPanel>
                    <ToggleButton x:Name="tglKeyboard" Style="{DynamicResource ExpanderToggle}" IsChecked="True" DockPanel.Dock="Left"
                                  Checked="OnKeyboardToggled" Unchecked="OnKeyboardToggled" ToolTip="Show or hide the keyboard">
                        <TextBlock Text="KEYBOARD" Style="{DynamicResource CapsLabel}" Foreground="{DynamicResource Text}"/>
                    </ToggleButton>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ToggleButton x:Name="tglPedals" Style="{DynamicResource ToolToggle}" Height="24" Padding="8,0" Margin="0,0,8,0"
                                      Focusable="False" IsChecked="True" Click="OnPedalsToggled"
                                      ToolTip="Show the piano pedals next to the keyboard: they go down while the song (or the MIDI input) presses them">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7FC;" Style="{DynamicResource Icon}" FontSize="11" Margin="0,0,5,0"/>
                                <TextBlock Text="Pedals" FontSize="11"/>
                            </StackPanel>
                        </ToggleButton>
                        <Button x:Name="btnFingering" Style="{DynamicResource ToolButton}" Height="24" Padding="8,0" Margin="0,0,14,0"
                                Click="OnFingeringMenuClick" Focusable="False"
                                ToolTip="How the edited track is fingered (hands, pairs), finger corrections and the fingering report">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C9;" Style="{DynamicResource Icon}" FontSize="11" Margin="0,0,5,0"/>
                                <TextBlock x:Name="txtFingering" Text="Fingering" FontSize="11"/>
                                <TextBlock Text="&#xE70D;" Style="{DynamicResource Icon}" FontSize="8" Margin="5,1,0,0"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="LABELS" Style="{DynamicResource CapsLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cmbKeyLabels" Width="150" Height="24" SelectedIndex="0" SelectionChanged="OnKeyLabelsChanged"
                                  ToolTip="What is written on pressed keys">
                            <ComboBoxItem Content="Fingers &amp; hands"/>
                            <ComboBoxItem Content="Note names"/>
                            <ComboBoxItem Content="Nothing"/>
                        </ComboBox>
                        <TextBlock Text="RANGE" Style="{DynamicResource CapsLabel}" Margin="14,0,8,0"/>
                        <ComboBox x:Name="cmbKeyRange" Width="120" Height="24" SelectedIndex="0" SelectionChanged="OnKeyRangeChanged"
                                  ToolTip="Keys shown across the window">
                            <ComboBoxItem Content="88 keys"/>
                            <ComboBoxItem Content="Song range"/>
                            <ComboBoxItem Content="61 keys"/>
                            <ComboBoxItem Content="49 keys"/>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Finger badges: blue = left hand, orange = right hand">
                            <Ellipse Width="9" Height="9" Fill="#3B82F6"/>
                            <TextBlock Text="L" Style="{DynamicResource CapsLabel}" Margin="4,0,10,0"/>
                            <Ellipse Width="9" Height="9" Fill="#F97316"/>
                            <TextBlock Text="R" Style="{DynamicResource CapsLabel}" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <kb:WheelPanel x:Name="wheels" DockPanel.Dock="Left"/>
            <kb:PedalPanel x:Name="pedals" DockPanel.Dock="Right"/>
            <kb:PianoKeyboard x:Name="keyboard" ToolTip="Click or drag to play notes"/>
        </DockPanel>

        <!-- Status bar -->
        <Border Grid.Row="9" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                Padding="10,3">
            <DockPanel>
                <TextBlock x:Name="txtRender" DockPanel.Dock="Right" Foreground="{DynamicResource TextFaint}" FontSize="11"
                           FontFamily="{DynamicResource MonoFont}"/>
                <TextBlock x:Name="txtStatus" Foreground="{DynamicResource TextDim}" FontSize="11" TextTrimming="CharacterEllipsis"
                           Text="1–4 tools  ·  Del delete  ·  Ctrl+C/X/V/D copy, cut, paste, duplicate  ·  ↑↓ transpose  ·  ←→ move  ·  Ctrl+Z undo  ·  Ctrl+wheel zoom  ·  middle-drag pan"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
