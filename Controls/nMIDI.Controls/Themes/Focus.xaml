<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:nMIDI.Controls.Skinning">
    <!-- Keyboard focus ring used by every focusable control that does not draw its own. -->
    <Style x:Key="{x:Static s:DawStyleKeys.FocusVisual}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-1" StrokeThickness="1" RadiusX="2" RadiusY="2" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource {x:Static s:DawSkinKeys.Focus}}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
