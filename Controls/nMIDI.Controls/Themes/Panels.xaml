<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:nMIDI.Controls"
                    xmlns:p="clr-namespace:nMIDI.Controls.Primitives"
                    xmlns:s="clr-namespace:nMIDI.Controls.Skinning">
    <BooleanToVisibilityConverter x:Key="DawPanelsBoolToVis"/>

    <!-- Small flat icon button (Content = a Path or text). -->
    <Style x:Key="{x:Static s:DawStyleKeys.IconButton}" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static s:DawStyleKeys.FocusVisual}}"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static s:DawSkinKeys.TextDim}}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <p:NineFrame Bevel="Raised" x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource {x:Static s:DawSkinKeys.CornerRadius}}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </p:NineFrame>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static s:DawSkinKeys.ButtonHover}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static s:DawSkinKeys.Text}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static s:DawSkinKeys.ButtonPressed}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact skinned ComboBox. -->
    <Style x:Key="{x:Static s:DawStyleKeys.ComboBox}" TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="20"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static s:DawSkinKeys.Text}}"/>
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static s:DawSkinKeys.FontFamily}}"/>
        <Setter Property="MaxDropDownHeight" Value="260"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static s:DawStyleKeys.FocusVisual}}"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ComboBoxItem}">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static s:DawSkinKeys.Text}}"/>
                    <Setter Property="Padding" Value="8,3"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static s:DawSkinKeys.ButtonHover}}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static s:DawSkinKeys.Accent}}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <p:NineFrame Bevel="Raised" x:Name="Bd" Background="{DynamicResource {x:Static s:DawSkinKeys.ButtonBackground}}" BorderBrush="{DynamicResource {x:Static s:DawSkinKeys.ButtonBorder}}"
                                            BorderThickness="1" CornerRadius="{DynamicResource {x:Static s:DawSkinKeys.CornerRadius}}">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Width="8" Height="8"
                                              Stretch="Uniform" Data="{DynamicResource {x:Static s:DawIconKeys.ChevronDown}}" Fill="{DynamicResource {x:Static s:DawSkinKeys.TextDim}}"/>
                                    </p:NineFrame>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static s:DawSkinKeys.ButtonHover}}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static s:DawSkinKeys.Accent}}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="6,0,18,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <p:NineFrame Bevel="Flat" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,0,0"
                                    Background="{DynamicResource {x:Static s:DawSkinKeys.PanelRaised}}" BorderBrush="{DynamicResource {x:Static s:DawSkinKeys.PanelBorder}}" BorderThickness="1" CornerRadius="{DynamicResource {x:Static s:DawSkinKeys.CornerRadius}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </p:NineFrame>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:DawPanel}">
        <Setter Property="Background" Value="{DynamicResource {x:Static s:DawSkinKeys.PanelBackground}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static s:DawSkinKeys.PanelBorder}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static s:DawSkinKeys.Text}}"/>
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static s:DawSkinKeys.FontFamily}}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:DawPanel}">
                    <p:NineFrame Bevel="Flat" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource {x:Static s:DawSkinKeys.CornerRadius}}">
                        <DockPanel>
                            <Grid x:Name="HeaderRow" DockPanel.Dock="Top" Height="24" Margin="8,2,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                  TextElement.FontSize="10" TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{DynamicResource {x:Static s:DawSkinKeys.TextDim}}"/>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Tools}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button x:Name="PART_Hide" Grid.Column="2" Style="{DynamicResource {x:Static s:DawStyleKeys.IconButton}}"
                                        ToolTip="Hide panel">
                                    <Path Width="9" Height="9" Stretch="Uniform" Data="{DynamicResource {x:Static s:DawIconKeys.Close}}"
                                          Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                                </Button>
                            </Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </DockPanel>
                    </p:NineFrame>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowHeader" Value="False">
                            <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="CanHide" Value="False">
                            <Setter TargetName="PART_Hide" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsShown" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type c:TrackHeader}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static s:DawSkinKeys.Text}}"/>
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static s:DawSkinKeys.FontFamily}}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="MinHeight" Value="46"/>
        <Setter Property="TrackColor" Value="{DynamicResource {x:Static s:DawSkinKeys.Accent}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:TrackHeader}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource {x:Static s:DawSkinKeys.PanelBorder}}" BorderThickness="0,0,0,1">
                        <Grid Margin="0,4,6,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.RowSpan="2" Margin="0,-4,0,-5" Background="{TemplateBinding TrackColor}"/>
                            <TextBlock x:Name="Number" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource {x:Static s:DawSkinKeys.LcdFontFamily}}" Foreground="{DynamicResource {x:Static s:DawSkinKeys.TextDim}}" Text="{Binding TrackNumber, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <c:MidiActivityMonitor x:Name="PART_Activity" Grid.Column="1" Grid.Row="1" Margin="0,4,0,0"
                                                   Layout="Compact" LaneCount="1" Width="10" Height="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   NoteBrush="{TemplateBinding TrackColor}"
                                                   Visibility="{TemplateBinding ShowActivity, Converter={StaticResource DawPanelsBoolToVis}}"/>
                            <TextBlock x:Name="Name" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Text="{TemplateBinding TrackName}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="Sub" Grid.Column="2" Grid.Row="1" Margin="0,4,6,0" VerticalAlignment="Center"
                                       FontSize="10" Foreground="{DynamicResource {x:Static s:DawSkinKeys.TextDim}}" Text="{TemplateBinding Subtitle}" TextTrimming="CharacterEllipsis"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                <c:LedToggleButton Role="Mute" Content="M" MinWidth="20" Margin="0,0,2,0" ToolTip="Mute"
                                                   IsChecked="{Binding IsMuted, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                <c:LedToggleButton Role="Solo" Content="S" MinWidth="20" Margin="0,0,2,0" ToolTip="Solo"
                                                   IsChecked="{Binding IsSoloed, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                <c:LedToggleButton Role="Monitor" MinWidth="24" ToolTip="Show notes on the keyboard and piano roll"
                                                   IsChecked="{Binding IsShownOnPiano, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <Path Width="12" Height="12" Stretch="Uniform" Data="{DynamicResource {x:Static s:DawIconKeys.Eye}}"
                                          Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                                </c:LedToggleButton>
                            </StackPanel>
                            <ComboBox Grid.Column="3" Grid.Row="1" Width="118" Margin="0,4,0,0" ToolTip="MIDI output device"
                                      Style="{DynamicResource {x:Static s:DawStyleKeys.ComboBox}}"
                                      ItemsSource="{TemplateBinding OutputDevices}"
                                      SelectedItem="{Binding SelectedOutputDevice, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Visibility="{TemplateBinding ShowDeviceSelector, Converter={StaticResource DawPanelsBoolToVis}}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static s:DawSkinKeys.ButtonBackground}}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static s:DawSkinKeys.TrackSelected}}"/>
                        </Trigger>
                        <Trigger Property="IsAudible" Value="False">
                            <Setter TargetName="Name" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="Number" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="Sub" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
