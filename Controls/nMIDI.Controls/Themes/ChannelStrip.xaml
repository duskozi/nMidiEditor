<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:nMIDI.Controls"
                    xmlns:p="clr-namespace:nMIDI.Controls.Primitives"
                    xmlns:s="clr-namespace:nMIDI.Controls.Skinning">
    <BooleanToVisibilityConverter x:Key="DawStripBoolToVis"/>

    <Style TargetType="{x:Type c:ChannelStrip}">
        <Setter Property="Width" Value="84"/>
        <Setter Property="MinHeight" Value="240"/>
        <Setter Property="Background" Value="{DynamicResource {x:Static s:DawSkinKeys.PanelBackground}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static s:DawSkinKeys.PanelBorder}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static s:DawSkinKeys.Text}}"/>
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static s:DawSkinKeys.FontFamily}}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TrackColor" Value="{DynamicResource {x:Static s:DawSkinKeys.Accent}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ChannelStrip}">
                    <p:NineFrame Bevel="Flat" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource {x:Static s:DawSkinKeys.CornerRadius}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Height="3" Background="{TemplateBinding TrackColor}" CornerRadius="2,2,0,0"/>
                            <TextBlock Grid.Row="1" Margin="4,5,4,2" HorizontalAlignment="Center" FontWeight="SemiBold"
                                       Text="{TemplateBinding TrackName}" TextTrimming="CharacterEllipsis"/>

                            <c:Knob Grid.Row="2" Width="42" Height="54" Margin="0,2,0,0" Label="PAN" IsBipolar="True"
                                    Minimum="-1" Maximum="1" DefaultValue="0" ArcBrush="{TemplateBinding TrackColor}"
                                    ValueFormatter="{x:Static p:ValueFormatters.Pan}"
                                    Value="{Binding Pan, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>

                            <!-- Fader cap is 40 high: scale and meters are padded by 20 so ticks align with the cap centre. -->
                            <Grid Grid.Row="3" Margin="2,8,4,4" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <c:ValueScale Placement="End" Padding="0,20,0,20" Minimum="-70" Maximum="6" Taper="Decibel"
                                              MinimumText="-∞" Ticks="6 0 -6 -12 -24 -40 -70"/>
                                <c:Fader x:Name="VolumeFader" Grid.Column="1" Width="28" ShowValueText="False"
                                         Taper="Decibel" Minimum="-70" Maximum="6" DefaultValue="0" MinimumText="-∞"
                                         ValueFormatter="{x:Static p:ValueFormatters.Decibel}"
                                         Value="{Binding Volume, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="3,14,0,20">
                                    <c:LevelMeter x:Name="PART_MeterLeft" Width="5"
                                                  Peak="{TemplateBinding PeakLeft}" Rms="{TemplateBinding RmsLeft}"/>
                                    <c:LevelMeter x:Name="PART_MeterRight" Width="5" Margin="2,0,0,0"
                                                  Peak="{TemplateBinding PeakRight}" Rms="{TemplateBinding RmsRight}"/>
                                </StackPanel>
                            </Grid>

                            <p:NineFrame Bevel="Sunken" Grid.Row="4" Margin="6,0,6,4" Padding="0,1" CornerRadius="{DynamicResource {x:Static s:DawSkinKeys.CornerRadius}}"
                                    Background="{DynamicResource {x:Static s:DawSkinKeys.LcdBackground}}" BorderBrush="{DynamicResource {x:Static s:DawSkinKeys.LcdBorder}}" BorderThickness="1">
                                <TextBlock HorizontalAlignment="Center" FontFamily="{DynamicResource {x:Static s:DawSkinKeys.LcdFontFamily}}" FontSize="11"
                                           Foreground="{DynamicResource {x:Static s:DawSkinKeys.LcdText}}" Text="{Binding ValueText, ElementName=VolumeFader}"/>
                            </p:NineFrame>

                            <UniformGrid Grid.Row="5" Rows="1" Margin="4,0,4,6">
                                <c:LedToggleButton Role="Mute" Content="M" Margin="1,0" ToolTip="Mute"
                                                   IsChecked="{Binding IsMuted, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                <c:LedToggleButton Role="Solo" Content="S" Margin="1,0" ToolTip="Solo"
                                                   IsChecked="{Binding IsSoloed, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                <c:LedToggleButton Role="RecordArm" Content="R" Margin="1,0" ToolTip="Record arm"
                                                   Visibility="{TemplateBinding ShowArmButton, Converter={StaticResource DawStripBoolToVis}}"
                                                   IsChecked="{Binding IsArmed, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            </UniformGrid>
                        </Grid>
                    </p:NineFrame>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
