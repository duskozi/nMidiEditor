<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>nMIDI.Controls</RootNamespace>
    <AssemblyName>nMIDI.Controls</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NinePatchWpf calls the 64-bit native NinePatchLib.dll, so everything runs as x64. -->
    <PlatformTarget>x64</PlatformTarget>

    <Version>2.0.0</Version>
    <RepositoryType>git</RepositoryType>
    <Product>nMIDI Controls</Product>
    <Description>WPF controls for MIDI/DAW applications (knobs, faders, meters, piano roll, step sequencer and more), drawn with NinePatchWpf where it pays off. Based on DawControls 1.1.1.</Description>
    <Authors>Duško</Authors>
    <Copyright>Copyright © 2026 Duško</Copyright>
  </PropertyGroup>

  <!-- NuGet package -->
  <PropertyGroup>
    <PackageId>nMIDI.Controls</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>wpf;midi;daw;audio;controls;knob;fader;meter;piano-roll;piano;mixer</PackageTags>
    <PackageReleaseNotes>First release as nMIDI.Controls (formerly DawControls 1.1.1): nine-patch rendering, Graphite skin, keyboard focus on every control, vector fallback without the native renderer.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- NinePatchWpf (prebuilt, from the editor's lib folder). Its two managed DLLs go into the package next to
       nMIDI.Controls.dll; the 64-bit native NinePatchLib.dll is copied to the output of every project that
       references this one, and the package copies it next to the app's exe (buildTransitive targets). -->
  <ItemGroup>
    <Reference Include="NinePatchWpf">
      <HintPath>..\..\lib\NinePatchWpf\NinePatchWpf.dll</HintPath>
    </Reference>
    <Reference Include="NinePatch.Core">
      <HintPath>..\..\lib\NinePatchWpf\NinePatch.Core.dll</HintPath>
    </Reference>
    <None Include="..\..\lib\NinePatchWpf\NinePatchLib.dll" Link="NinePatchLib.dll" Visible="false"
          CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes\win-x64\native" />
    <None Include="..\..\lib\NinePatchWpf\NinePatchWpf.dll;..\..\lib\NinePatchWpf\NinePatch.Core.dll;..\..\lib\NinePatchWpf\NinePatchWpf.xml;..\..\lib\NinePatchWpf\NinePatch.Core.xml"
          Visible="false" Pack="true" PackagePath="lib\net10.0-windows7.0" />
    <None Include="build\nMIDI.Controls.targets" Pack="true" PackagePath="buildTransitive;build" />
  </ItemGroup>

  <!-- The editor uses the rendering helpers (note skins, brush and text caches). -->
  <ItemGroup>
    <InternalsVisibleTo Include="nMIDIEditor" />
    <InternalsVisibleTo Include="nMIDI.Controls.Tests" />
  </ItemGroup>

</Project>
