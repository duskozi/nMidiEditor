<!-- Graphite skin of nMIDI.Controls. Copy this file into your app and change the colours to make your own skin. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:skin="clr-namespace:nMIDI.Controls.Skinning">
    <!-- Skin: Graphite -->
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.WindowBackground}" Color="#FF121316" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.PanelBackground}" Color="#FF1A1C20" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.PanelRaised}" Color="#FF24272D" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.PanelBorder}" Color="#FF2E3239" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.Text}" Color="#FFE7E9EC" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.TextDim}" Color="#FF8C929B" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.Accent}" Color="#FFFF9A3C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.AccentForeground}" Color="#FF1A1205" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.Focus}" Color="#99FF9A3C" po:Freeze="True"/>
    <RadialGradientBrush x:Key="{x:Static skin:DawSkinKeys.KnobBody}" GradientOrigin="0.35,0.3" Center="0.4,0.35" RadiusX="0.75" RadiusY="0.75" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF41454E"/>
        <GradientStop Offset="1" Color="#FF23262B"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.KnobBodyBorder}" Color="#FF0D0E10" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.KnobTrack}" Color="#FF0E0F12" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.KnobIndicator}" Color="#FFF2F3F5" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.FaderGroove}" Color="#FF0B0C0E" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.FaderFill}" Color="#55FF9A3C" po:Freeze="True"/>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.FaderThumb}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF5C616B"/>
        <GradientStop Offset="1" Color="#FF33363D"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.FaderThumbBorder}" Color="#FF0D0E10" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.FaderThumbLine}" Color="#FFFF9A3C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.MeterBackground}" Color="#FF0B0C0E" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.MeterSafe}" Color="#FF35D08A" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.MeterWarning}" Color="#FFF7C948" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.MeterDanger}" Color="#FFF2495C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.MeterPeakHold}" Color="#FFE7E9EC" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.MeterClipOn}" Color="#FFF2495C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.MeterClipOff}" Color="#FF2A1C1F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ScaleTick}" Color="#FF4A4F58" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ScaleText}" Color="#FF7D838C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ButtonBackground}" Color="#FF2A2D33" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ButtonHover}" Color="#FF33373E" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ButtonPressed}" Color="#FF1F2126" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ButtonBorder}" Color="#FF111214" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LedMute}" Color="#FFF7C948" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LedSolo}" Color="#FF4CC2FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LedArm}" Color="#FFF2495C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LedMonitor}" Color="#FFB18CFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LedLitForeground}" Color="#FF111214" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.TransportPlay}" Color="#FF35D08A" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.TransportRecord}" Color="#FFF2495C" po:Freeze="True"/>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.LcdBackground}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF0F1311"/>
        <GradientStop Offset="1" Color="#FF0A0D0B"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LcdBorder}" Color="#FF2A2F2C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LcdText}" Color="#FFFFB25E" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LcdTextDim}" Color="#FF7A5A35" po:Freeze="True"/>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.KeyWhite}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FFF1F2F4"/>
        <GradientStop Offset="1" Color="#FFD3D6DB"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.KeyBlack}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF2E3035"/>
        <GradientStop Offset="1" Color="#FF151619"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.KeyBorder}" Color="#FF0E0F11" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.KeyPressed}" Color="#FFFF9A3C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.KeyHighlight}" Color="#B04CC2FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.GridBackground}" Color="#FF1D2024" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.GridBlackRow}" Color="#FF17191C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.GridBarLine}" Color="#FF464B54" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.GridBeatLine}" Color="#FF30343A" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.GridSubLine}" Color="#FF24272C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.NoteFill}" Color="#FFFF9A3C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.NoteSelectedFill}" Color="#FFFFE1BD" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.NoteBorder}" Color="#C0000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.NoteText}" Color="#CC1A1205" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.Playhead}" Color="#FFF5F7FA" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.RulerBackground}" Color="#FF22252A" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.RulerText}" Color="#FF9CA2AB" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.Selection}" Color="#334CC2FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.StepOff}" Color="#FF2B2E34" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.StepOn}" Color="#FFFF9A3C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.StepGroupBackground}" Color="#FF1F2226" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.StepPlayhead}" Color="#22FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.PadBackground}" Color="#FF14161A" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.PadGrid}" Color="#FF262A30" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.PadPuck}" Color="#FFFF9A3C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.PadCrosshair}" Color="#66FF9A3C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.EnvelopeStroke}" Color="#FFFF9A3C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.EnvelopeFill}" Color="#33FF9A3C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.WheelSlot}" Color="#FF08090B" po:Freeze="True"/>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.WheelBody}" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF26292F"/>
        <GradientStop Offset="0.45" Color="#FF4A4F58"/>
        <GradientStop Offset="1" Color="#FF26292F"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.WheelRib}" Color="#FF0B0C0E" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.WheelMarker}" Color="#FFFF9A3C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.PedalBody}" Color="#FF3A3E46" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.PedalLit}" Color="#FFFF9A3C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ActivityNote}" Color="#FF35D08A" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ActivityControl}" Color="#FF4CC2FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ActivityOff}" Color="#FF101114" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ActivityRowAlt}" Color="#FF1D2024" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.TrackSelected}" Color="#FF2A2E35" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LaneValue}" Color="#FFFF9A3C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LaneFill}" Color="#33FF9A3C" po:Freeze="True"/>
    <CornerRadius x:Key="{x:Static skin:DawSkinKeys.CornerRadius}">3</CornerRadius>
    <FontFamily x:Key="{x:Static skin:DawSkinKeys.FontFamily}">Segoe UI</FontFamily>
    <FontFamily x:Key="{x:Static skin:DawSkinKeys.LcdFontFamily}">Consolas</FontFamily>
    <sys:Double x:Key="{x:Static skin:DawSkinKeys.KnobArcThickness}">3.5</sys:Double>
</ResourceDictionary>
